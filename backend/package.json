{
  "name": "@product31/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file=.env node_modules/knex/bin/cli.js migrate:latest",
    "migrate:make": "node node_modules/knex/bin/cli.js migrate:make",
    "migrate:rollback": "node --env-file=.env node_modules/knex/bin/cli.js migrate:rollback",
    "seed": "node --env-file=.env node_modules/knex/bin/cli.js seed:run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
