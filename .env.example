# ── Product 31 — example environment ────────────────────────────────────────
# Copy to backend/.env (and frontend/.env) and fill in REAL values.
# NEVER commit the filled-in .env files. (spec §8)
#
# This root file documents every variable the project uses. The backend reads
# backend/.env; the frontend reads frontend/.env (only VITE_* vars are exposed
# to the browser).

# ── Backend: runtime ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Backend: database (Supabase Postgres — spec §12) ───────────────────────
# One Postgres engine for every environment (local dev included), reached via
# Knex. Use the "Connection string" / "Session pooler" URI from your Supabase
# project: Settings → Database. Local-only alternative: `supabase start` then
# use the local connection string it prints.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Set to "require" for hosted Supabase, "disable" for a plain local Postgres.
DATABASE_SSL=require

# ── Backend: auth / JWT (spec §8) ─────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Backend: OTP ─────────────────────────────────────────────────────────
# Keyed hash pepper for OTP-at-rest. Generate like the JWT secrets above.
OTP_PEPPER=change-me-otp-pepper
OTP_TTL_SECONDS=300
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5
# When true (dev only), OTPs are NOT sent by SMS — the code is returned in the
# API response and logged. Force-disabled when NODE_ENV=production.
OTP_MOCK=true

# ── Backend: SMS OTP provider (MSG91 — the one paid piece, spec §12) ───────
# Leave blank while OTP_MOCK=true. Required before real users.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# DLT template for the "your order was rejected" SMS (the only order-status SMS).
MSG91_REJECT_TEMPLATE_ID=

# ── Backend: CORS ────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. No wildcards. (spec §8)
CORS_ORIGINS=http://localhost:5173

# ── Backend: public URLs (QR deep links — spec §11) ───────────────────────
PUBLIC_WEB_BASE_URL=http://localhost:5173

# ── Frontend (frontend/.env) ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
